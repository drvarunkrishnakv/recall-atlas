# Firebase web config for the cloud build (npm run dev:cloud / build:cloud).
# Copy to .env.local and fill in from Firebase console → Project settings → Your apps.
# These identify the project; they aren't secrets. Firestore rules keep the notes private.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
