{
  "name": "mains-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:notes": "ATLAS_CONTENT_DIR=../output/notes-pilot/content vite --host 0.0.0.0 --port 5173",
    "dev:fixture": "vite --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"cli/**/*.ts\" \"mcp/**/*.ts\" \"e2e/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"cli/**/*.ts\" \"mcp/**/*.ts\" \"e2e/**/*.ts\" \"*.config.ts\"",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build",
    "atlas": "node cli/atlas.ts",
    "mcp": "node mcp/dist/atlas-mcp.mjs",
    "mcp:http": "node mcp/dist/atlas-mcp.mjs --http 5190",
    "mcp:build": "rolldown mcp/atlas-mcp.ts -o mcp/dist/atlas-mcp.mjs -p node -f esm --no-code-splitting --external firebase-admin/app --external firebase-admin/firestore",
    "discuss:serve": "bash mcp/serve.sh",
    "dev:cloud": "vite --mode cloud --host 0.0.0.0 --port 5173",
    "build:cloud": "tsc -b && vite build --mode cloud",
    "test:cloud": "npx --yes firebase-tools@15 emulators:exec --project demo-atlas --only firestore,auth \"vitest run --config vitest.cloud.config.ts\"",
    "mcp:function": "rolldown mcp/function.ts -o ../functions/index.js -p node -f esm --no-code-splitting --external firebase-admin/app --external firebase-admin/firestore --external firebase-admin/auth --external firebase-functions/v2/https"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "firebase": "^12.19.0",
    "mermaid": "^12.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
